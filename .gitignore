# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# superpowers execution workspaces (ledgers, review packages)
.superpowers/

# Third-party papers are copyrighted; see Ref/README.md for links
Ref/*.pdf

# Downloaded datasets (fetched by scripts, never committed)
data/raw/

# Manuscript drafts stay local: this repository is public
paper/

# Local Claude Code settings and hooks (e.g. LaTeX auto-compile); not shared
.claude/

# Intermediate caches that experiments regenerate (E11 learning and bootstrap)
results/e11_stage1.npz

# Per-job partial results of E15 (resumable run); the combined cache is results/e15_coverage.npz
results/e15_parts/

# Truth caches of E11f (outcome distributions, ~17 MB each); regenerated by `e11f_nonmarkov_truths.py --truths`
results/e11f_parts/

# Truth caches of E11h (outcome distributions); regenerated by `e11h_transient_truths.py --truths`
results/e11h_parts/
results/e23c_parts/
results/e23k_parts/
results/e25_parts/
results/e26_parts/
